# ── Telegram ──
# Токен от @BotFather. НЕ присылай его в чат и не коммить: .env в .gitignore.
BOT_TOKEN=

# ── Mini App ──
# Адрес, по которому открывается приложение. Обязательно https:// — Telegram
# не открывает http. Это публичный адрес папки web/, выложенной на GitHub Pages
# (или любой другой статический хостинг). Бот только присылает кнопку с этим
# адресом по /start, сам он ничего не раздаёт и нигде не хостится.
WEBAPP_URL=
